# Stack-wide secrets. Copy to `.env` (gitignored). Every service that needs a
# value reads it via `env_file:`. Keep AgentMemory's own profile in a separate
# agentmemory.env (see agentmemory.env.example) so it mounts only to that container.

# Node environment
NODE_ENV=development

# PostgreSQL (example — include only if your stack ships a DB)
POSTGRES_USER=<DB_USER>
POSTGRES_PASSWORD=<DB_PASSWORD>
POSTGRES_DB=<DB_NAME>

# Message broker (example — include only if your stack ships one)
RABBITMQ_USER=<BROKER_USER>
RABBITMQ_PASSWORD=<BROKER_PASSWORD>

# Third-party API keys, object-storage creds, etc. go here — never inline in
# docker-compose.yml, Dockerfiles, scripts, or markdown.
