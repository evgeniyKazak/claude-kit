# AgentMemory profile — copy to `agentmemory.env` and fill the placeholders.
# Mounted exclusively into the agentmemory container via `env_file:`.
# This "balanced" profile = local Ollama embeddings + local Ollama LLM compress.

# === LLM provider (compress) ===
# Local Ollama via OpenAI-compatible /v1 endpoint. Requires the upstream patch
# that adds `ollama` to ProviderType (detected when OLLAMA_BASE_URL is set) —
# see ADR-0002.
#   • Ollama runs as a docker service (NVIDIA/CPU host): use the container name →
#       http://ollama:11434/v1
#   • Ollama runs natively on the host (Apple Silicon Mac — strongly preferred):
#       http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_API_KEY=ollama
# Cap compress output. Upstream default 4096 → ~22s on a 7B model.
# 1024 tokens is plenty for an observation summary and cuts latency ~4x.
MAX_TOKENS=1024
# Skip the LLM compress path for trivial observations (raw payload below this
# byte threshold) — synthetic compression is equally good for tiny outputs.
AGENTMEMORY_COMPRESS_MIN_BYTES=512
# Cloud-key alternatives (leave commented unless switching the provider):
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# MINIMAX_API_KEY=
AGENTMEMORY_ALLOW_AGENT_SDK=false

# === Capture / processing ===
AGENTMEMORY_AUTO_COMPRESS=true
GRAPH_EXTRACTION_ENABLED=false
AGENTMEMORY_SLOTS=false
AGENTMEMORY_REFLECT=false
SNAPSHOT_ENABLED=false
OBSIDIAN_AUTO_EXPORT=false

# === Hybrid memory mode ===
# true → SessionStart hook writes ~1-2k tokens of project context into the
# first turn (in addition to Claude's MEMORY.md). Set false for capture-only.
AGENTMEMORY_INJECT_CONTEXT=true
# Bridge with Claude Code's MEMORY.md is OFF on purpose to avoid two-writer drift.
CLAUDE_MEMORY_BRIDGE=false

# === Search (embeddings) ===
# Hybrid BM25 + dense embeddings via local Ollama (mxbai-embed-large, 1024-dim).
# Use the SAME embedding model your app uses so the vector space stays unified.
# OPENAI_API_KEY is a dummy required by the OpenAI client; Ollama ignores it.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=ollama
# Same host rule as OLLAMA_BASE_URL above: container name on a docker Ollama,
# http://host.docker.internal:11434/v1 when Ollama runs natively on the host.
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_EMBEDDING_MODEL=mxbai-embed-large
OPENAI_EMBEDDING_DIMENSIONS=1024

# === MCP surface ===
# 8-tool minimal surface. Switch to "all" for the full 51-tool catalog only
# when you have a concrete reason — the larger surface fills the MCP slug.
AGENTMEMORY_TOOLS=core

# === Auth ===
# Bearer for REST :3111. Generate with: openssl rand -hex 32
# MUST match the value the hook runner exports (see shared-hooks/agentmemory-run.sh).
AGENTMEMORY_SECRET=<GENERATE_WITH_openssl_rand_hex_32>

# === Storage path inside the container ===
AGENTMEMORY_EXPORT_ROOT=/data/export

# === Network ===
III_REST_PORT=3111
